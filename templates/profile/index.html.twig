{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}

<div class="flex flex-row ">

    <twig:Sidebar />

    <div class=" w-4/5 flex flex-col bg-gray-50 ">
    
    <h1 class="font-bold pb-6 pt-6  text-2xl">
            Mon Profil
        </h1>
                
        <div class="flex flex-col pl-6 pr-6 pt-8 bg-white rounded-2xl">
            <p class="text-gray-400">Raison Sociale</p>
            <input type="text" class=" border-2 h-12 border-gray-200 rounded-lg" placeholder="Ex: Tech Solutions">
            <p class="text-gray-400">Le nom de votre entreprise qui apparaîtra sur vos factures</p>
            <p class="pt-6">Numéro de SIRET (Optionnel)</p>
            <input type="text" class=" border-2 h-12 border-gray-200 rounded-lg" placeholder="Ex: 45659725656356 ">
            <p class="pt-6">IBAN</p>
            <input type="text" class=" border-2 h-12 border-gray-200 rounded-lg" placeholder="FR76 1234 5678 5687 1458 2587 548">
            <p class="text-gray-400">Compte bancaire qui recevra les virements de vos clients</p>
            <p class="pt-6">Conditions Générales de Vente (CVG)</p>
            <textarea 
            class="px-4 py-3  border-2  border-gray-200 rounded-lg w-full h-32 resize-none" placeholder="Ces conditions apparaîtront en bas de vos factures PDF..." 
            ></textarea>


        </div>

    </div>

</div>

{% endblock %}
