{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}

<div class="flex flex-row ">

    <twig:Sidebar />

    <div class=" w-4/5 flex flex-col bg-white">

        <h1 class="font-bold text-2xl">
            Mon Profil
        </h1>

        <div class="flex flex-col pl-6 pr-6 ">
            <p class="text-gray-500">Raison Sociale</p>
            <input type="text" class=" border-2  border-gray-200 rounded-lg" placeholder="Ex: Tech Solutions">
            <p>Le nom de votre entreprise qui apparaîtra sur vos factures</p>
            <p>Numéro de SIRET (Optionnel)</p>
            <input type="text" class=" border-2  border-gray-200 rounded-lg" placeholder="Ex: 45659725656356 ">
            <p>IBAN</p>
            <input type="text" class=" border-2  border-gray-200 rounded-lg" placeholder="FR76 1234 5678 5687 1458 2587 548">
            <p>Compte bancaire qui recevra les virements de vos clients</p>
            <p>Conditions Générales de Vente (CVG)</p>
            <textarea class="pl-4 pr-4 py-3  border-2  border-gray-200 rounded-lg w-full h-32 resize-none" placeholder="Ces conditions apparaîtront en bas de vos factures PDF..." >
            </textarea>


        </div>

    </div>

</div>

{% endblock %}
