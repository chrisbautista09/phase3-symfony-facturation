{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}

<div class="flex flex-row ">

    <twig:Sidebar />

    <div class=" w-4/5 flex flex-col bg-white">

        <h1 class="font-bold">
            Mon Profil
        </h1>

        <div class="flex flex-col">
            <p class="text-gray-500">Raison Sociale</p>
            <input type="text" placeholder="Ex: Tech Solucions">
            <p>Le nom de votre entreprise qui apparaîtra sur vos factures</p>
            <p>Numéro de SIRET (Optionnel)</p>
            <input type="text" placeholder="Ex: 45659725656356 ">
            <p>IBAN</p>
            <input type="text" placeholder="FR76 1234 5678 5687 1458 2587 548">
            <p>Compte bancaire qui recevra les virements de vos clients</p>
            <p>Conditions Générales de Vente (CVG)</p>
            <textarea shape="Ces conditions apparaîtront en bas de vos factures PDF..." coords="" href="" alt="">
            </textarea>


        </div>

    </div>

</div>

{% endblock %}
